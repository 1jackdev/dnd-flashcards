{
	"name": "dnd-flashcards",
	"module": "src/main.ts",
	"type": "module",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"ci:biome": "biome ci .",
		"dev": "bun run --hot src/main.ts",
		"start": "bun run src/main.ts",
		"db:gen": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run src/infrastructure/db/seed.ts"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "^1.3.14",
		"better-sqlite3": "^13.0.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.5",
		"@hono/zod-validator": "^0.9.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32",
		"zod": "^4.4.3"
	}
}
